# Supabase project configuration. The anon/publishable key is designed for clients;
# enable Anonymous Sign-Ins and apply supabase_guest_setup.sql before using shared data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Without valid Supabase values the app runs in local demo mode and stores data on this device.
